{
  "manifest_version": 3,
  "name": "Teams Recap Transcript Exporter",
  "version": "2.4.0",
  "description": "Exports Microsoft Teams Recap transcripts and full weekly Teams conversation context for work reports.",
  "permissions": [
    "sidePanel",
    "downloads",
    "clipboardWrite",
    "nativeMessaging",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.sharepoint.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.teams.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.sharepoint.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*"
      ],
      "js": [
        "calendar.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*"
      ],
      "js": [
        "chat-search.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Teams Recap Transcript Exporter"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "key": ""
}
